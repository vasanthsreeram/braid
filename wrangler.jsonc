{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-native-forge-evaluation",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 300000 },
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "cf-native-forge-evaluation" },
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "cf-native-forge-lfs-evaluation" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-native-forge-evaluation",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "WORKOS_CLIENT_ID": "UNCONFIGURED",
    "ORIGIN": "https://unconfigured.invalid",
    "ALLOW_PUBLIC": "false",
  },
  "observability": { "enabled": false },
}
