{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-native-forge-evaluation",
  "account_id": "7efeb52ec5727a903edd8ef7ae8eb925",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "gitflare.lintlabs.org", "custom_domain": true }],
  "preview_urls": false,
  "limits": { "cpu_ms": 300000 },
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "cf-native-forge-evaluation" },
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "cf-native-forge-lfs-evaluation" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-native-forge-evaluation",
      "database_id": "200d9a4f-b51b-451a-86ab-43b1b29847d3",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "WORKOS_CLIENT_ID": "client_01M3WQ9VJ9G2MH74MYP7WBD708",
    "WORKOS_ACCESS_TOKEN_ISSUER": "https://api.workos.com",
    "WORKOS_ISSUER": "https://api.workos.com/user_management/client_01M3WQ9VJ9G2MH74MYP7WBD708",
    "ORIGIN": "https://gitflare.lintlabs.org",
    "ALLOW_PUBLIC": "false",
    "R2_ACCOUNT_ID": "7efeb52ec5727a903edd8ef7ae8eb925",
    "R2_BUCKET_NAME": "cf-native-forge-lfs-evaluation",
  },
  "observability": { "enabled": false },
}
